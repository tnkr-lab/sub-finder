# Supabase — get from https://app.supabase.com/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — never NEXT_PUBLIC_

# Anthropic — get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=                # server only

# VAPID — generate: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=                # server only
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=     # safe to expose (public by design)

# Twilio — get from https://console.twilio.com
TWILIO_ACCOUNT_SID=               # server only
TWILIO_AUTH_TOKEN=                # server only
TWILIO_PHONE_NUMBER=              # e.g. +61400000000
